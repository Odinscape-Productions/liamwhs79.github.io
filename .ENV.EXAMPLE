PORT=4173
JWT_SECRET=change-this-to-a-long-random-secret
APP_ORIGIN=http://localhost:4173

# Optional. Leave unset locally to use ./data.
# Persistent Render config sets this to /var/data.
DATA_DIR=

# PSN syncing is OFF by default. This starter intentionally does not scrape,
# reverse engineer, or ask users to hand over PlayStation passwords.
PSN_SYNC_MODE=disabled
PSN_PROVIDER_BASE_URL=
PSN_PROVIDER_TOKEN=
